DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce_mvp?schema=public"
PORT=4000

# Signs staff and customer JWTs. Generate a real random value for
# production (e.g. `openssl rand -hex 32`) — never reuse the placeholder.
JWT_SECRET="change-me-in-production"

# Restricts which frontend origin can call this API. Leave unset for local
# development (allows any origin). In production, set this to your deployed
# frontend URL, e.g. "https://your-app.vercel.app" — no trailing slash.
CORS_ORIGIN=

# NOTE: OTP provider endpoints/API keys (WhatsApp, email) are NOT
# configured here. They're stored in the database (NotificationProvider
# table) and managed from the dashboard's Settings screen, so they can
# be changed without a redeploy. See src/services/notificationService.js.

# --- Product image storage (S3-compatible) ---
# Works with any S3-compatible provider. Cloudflare R2 is recommended
# for the free-tier testing setup — it has a genuinely free tier with
# no egress/bandwidth fees (unlike AWS S3, which charges per GB served).
# Leave these unset and image upload will be disabled with a clear
# message in the dashboard, rather than failing unpredictably.
#
# Cloudflare R2 setup: dashboard.cloudflare.com -> R2 -> Create bucket
# -> Manage R2 API Tokens -> Create API token, then:
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ecommerce-mvp-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Enable "Public Access" on the R2 bucket to get this base URL
# (Settings -> Public Access -> Allow Access -> use the r2.dev URL,
# or attach a custom domain):
S3_PUBLIC_URL_BASE=https://pub-xxxxxxxxxxxx.r2.dev
